# Caddy reverse proxy for agent-illusion.
# Domain is set to mimvora.tech below. Caddy obtains + renews HTTPS automatically.

mimvora.tech {
	encode gzip

	# The admin console lives at your secret ADMIN_PATH and requires a login.
	# For extra safety you can also restrict that path to your own IP here
	# (replace /ADMIN_PATH with the real value from the systemd unit):
	# @console path /ADMIN_PATH /ADMIN_PATH/*
	# handle @console {
	#     @allowed remote_ip 1.2.3.4   # <- put your office/home IP here
	#     handle @allowed { reverse_proxy 127.0.0.1:8080 }
	#     respond 403
	# }

	reverse_proxy 127.0.0.1:8080

	log {
		output file /var/log/caddy/agent-illusion.log
	}
}

# Optional: also serve www -> apex
www.mimvora.tech {
	redir https://mimvora.tech{uri}
}
